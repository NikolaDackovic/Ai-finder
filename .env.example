PORT=3030

# AI provider: openai or gemini
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Serper.dev - used for web discovery
SERPER_API_KEY=

# Search tuning
SEARCH_COUNTRY=rs
SEARCH_LANGUAGE=sr
MAX_SEARCH_RESULTS=50
MAX_PAGES_PER_SITE=10
CRAWL_CONCURRENCY=3
REQUEST_TIMEOUT_MS=12000
LEAD_COOLDOWN_DAYS=30

# Your outreach identity
YOUR_NAME=
YOUR_COMPANY=
YOUR_WEBSITE=
YOUR_EMAIL=
YOUR_PHONE=

# SMTP email sending (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=
EMAIL_TEST_MODE=true
EMAIL_TEST_TO=
DEFAULT_EMAIL_SUBJECT=

# Optional: absolute or relative path to your master PDF.
MASTER_PDF=./templates/master-offer.pdf
